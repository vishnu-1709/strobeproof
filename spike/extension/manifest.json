{
  "manifest_version": 3,
  "name": "Strobeproof Spike (M0)",
  "version": "0.0.1",
  "description": "M0 spike kit for Strobeproof. Developer use only. Not the product.",
  "permissions": ["storage", "offscreen", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "spike.html", "default_title": "Strobeproof spike" }
}
